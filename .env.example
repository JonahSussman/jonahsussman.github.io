# Headscale OIDC (Google)
# Create at: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
HEADSCALE_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
HEADSCALE_OIDC_CLIENT_SECRET=your-client-secret

# Allowed users are listed in headscale/allowed_users.txt (one email per line)
